generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
}

enum CredentialVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum CredentialStatus {
  ACTIVE
  REVOKED
}

enum CredentialType {
  COURSE
  EVENT
  PARTICIPATION
  ACHIEVEMENT
  EMPLOYMENT
  INTERNSHIP
  DEGREE
  MEMBERSHIP
  OTHER
}

enum OrgRole {
  ADMIN
  ISSUER
  SIGNATORY
}

enum DomainStatus {
  NONE
  PENDING
  VERIFIED
}

model User {
  id                String            @id @default(cuid())
  handle            String            @unique
  email             String            @unique
  name              String
  passwordHash      String
  bio               String?
  emailVerifiedAt   DateTime?
  profileVisibility ProfileVisibility @default(PUBLIC)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  emailTokens        EmailToken[]
  memberships        Membership[]
  credentials        Credential[]     @relation("Recipient")
  issuedCredentials  Credential[]     @relation("Issuer")
  createdOrgs        Organization[]   @relation("OrgCreator")
  auditLogs          AuditLog[]
}

model EmailToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Organization {
  id               String       @id @default(cuid())
  slug             String       @unique
  name             String
  description      String?
  website          String?
  domain           String?
  domainStatus     DomainStatus @default(NONE)
  domainToken      String
  domainVerifiedAt DateTime?
  parentId         String?
  createdById      String
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  parent      Organization?  @relation("OrgTree", fields: [parentId], references: [id])
  children    Organization[] @relation("OrgTree")
  createdBy   User           @relation("OrgCreator", fields: [createdById], references: [id])
  keys        OrgKey[]
  memberships Membership[]
  templates   Template[]
  credentials Credential[]
  auditLogs   AuditLog[]

  @@index([parentId])
}

model OrgKey {
  id                  String   @id
  orgId               String
  publicKey           String
  encryptedPrivateKey String
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())

  org         Organization @relation(fields: [orgId], references: [id])
  credentials Credential[]

  @@index([orgId])
}

model Membership {
  id        String    @id @default(cuid())
  userId    String
  orgId     String
  roles     OrgRole[]
  title     String?
  createdAt DateTime  @default(now())

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  signatories TemplateSignatory[]

  @@unique([userId, orgId])
  @@index([orgId])
}

model Template {
  id          String         @id @default(cuid())
  orgId       String
  name        String
  type        CredentialType
  description String?
  fields      Json
  accentColor String         @default("#4f46e5")
  archived    Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  org         Organization        @relation(fields: [orgId], references: [id])
  signatories TemplateSignatory[]
  credentials Credential[]

  @@index([orgId])
}

model TemplateSignatory {
  templateId   String
  membershipId String
  position     Int

  template   Template   @relation(fields: [templateId], references: [id], onDelete: Cascade)
  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@id([templateId, membershipId])
}

model Credential {
  id             String               @id
  orgId          String
  templateId     String
  recipientId    String?
  recipientEmail String
  recipientName  String
  title          String
  type           CredentialType
  payload        Json
  payloadHash    String
  signature      String
  keyId          String
  visibility     CredentialVisibility @default(PUBLIC)
  status         CredentialStatus     @default(ACTIVE)
  issuedAt       DateTime
  expiresAt      DateTime?
  revokedAt      DateTime?
  revokedReason  String?
  issuedById     String
  createdAt      DateTime             @default(now())

  org       Organization @relation(fields: [orgId], references: [id])
  template  Template     @relation(fields: [templateId], references: [id])
  recipient User?        @relation("Recipient", fields: [recipientId], references: [id])
  issuedBy  User         @relation("Issuer", fields: [issuedById], references: [id])
  key       OrgKey       @relation(fields: [keyId], references: [id])

  @@index([recipientId])
  @@index([recipientEmail])
  @@index([orgId, issuedAt(sort: Desc)])
}

model AuditLog {
  id         String   @id @default(cuid())
  orgId      String?
  actorId    String?
  action     String
  targetType String
  targetId   String
  meta       Json?
  createdAt  DateTime @default(now())

  org   Organization? @relation(fields: [orgId], references: [id])
  actor User?         @relation(fields: [actorId], references: [id])

  @@index([orgId, createdAt])
}
